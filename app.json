{
  "expo": {
    "name": "HRM-EOVO",
    "slug": "hrm-app",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to set a profile picture.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to take your profile photo and documents."
        }
      ],
      "expo-background-task",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "HRM-EOVO uses your location to mark your attendance when you reach the office.",
          "locationWhenInUsePermission": "HRM-EOVO uses your location to mark your attendance when you reach the office.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysPermission": "HRM-EOVO uses your location in the background to mark your in-time and going-time automatically when you reach or leave the office."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      "expo-sharing"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "HRM-EOVO uses your location to mark your attendance when you reach the office.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "HRM-EOVO uses your location to mark your attendance when you reach the office.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      },
      "entitlements": {
        "com.apple.developer.networking.wifi-info": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.zapsolutionz.hrm",
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 5
    },
    "extra": {
      "apiUrl": "https://hrm.zapsolutionz.com",
      "office": {
        "wifiNames": [
          "PUT-OFFICE-WIFI-NAME-HERE",
          "PUT-OFFICE-WIFI-NAME-HERE"
        ],
        "location": {},
        "autoSignIn": {
          "from": "06:00",
          "until": "22:00"
        },
        "lunch": {
          "from": "13:00",
          "until": "14:00"
        },
        "autoSignOut": {
          "confirmMinutes": 10
        }
      },
      "eas": {
        "projectId": "c5cc4c9b-f8c1-4fcf-9337-36ce5b5d961a"
      }
    },
    "owner": "surajzapkandivali"
  }
}
